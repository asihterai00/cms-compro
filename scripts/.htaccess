# Prevent direct HTTP web access and redirect cleanly to branded error page
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^.*$ /cms-compro/error?code=403 [R=302,L]
</IfModule>
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
